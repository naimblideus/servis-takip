# Nextus Servis — ortam değişkenleri
#
# Bu dosya ŞABLONDUR, gerçek değer İÇERMEZ. Kopyala: cp .env.example .env
# Üretimde değerler Coolify → Environment Variables altında tanımlanır.
# Liste koddan çıkarıldı (grep process.env). Yeni değişken eklersen buraya da yaz.

# ─────────────────────────────────────────────────────────────
# ZORUNLU — bunlar olmadan uygulama düzgün çalışmaz
# ─────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani"

# Oturum imzalama anahtarı. Değiştirirsen TÜM kullanıcılar çıkış yapar (beklenen).
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXTAUTH_SECRET=""          # AUTH_SECRET ile aynı değer
NEXTAUTH_URL="https://alanadin.com"
NEXT_PUBLIC_APP_URL="https://alanadin.com"

# ─────────────────────────────────────────────────────────────
# GÜVENLİK — tanımlı DEĞİLSE ilgili uç TAMAMEN KAPANIR (fail-closed).
# Bu bilinçlidir: yanlış açık kalmaktansa çalışmasın.
# ─────────────────────────────────────────────────────────────

# Zamanlanmış görevler (run-cron.mjs) bunsuz çalışmaz.
CRON_SECRET=""

# Süper-admin oturumu. En az 16 karakter olmalı, yoksa süper-admin devre dışı.
SUPER_ADMIN_SECRET=""

# Kurulum uçları için. Tanımsızsa o uçlar kapalıdır.
SETUP_SECRET=""

# İLK admin hesabı — YALNIZCA veritabanında hiç kullanıcı yokken kullanılır.
# Mevcut kullanıcıların şifresine asla dokunulmaz. Verilmezse rastgele şifre
# üretilip konteyner loguna yazılır.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# ─────────────────────────────────────────────────────────────
# WHATSAPP (Meta Cloud API) — kurulum: NEXUS-DEVIR/06-WHATSAPP-KURULUM.md
# ─────────────────────────────────────────────────────────────

# Meta App Secret. YOKSA WEBHOOK HİÇBİR MESAJI KABUL ETMEZ (imza doğrulanamaz).
WHATSAPP_APP_SECRET=""

# Webhook doğrulaması için kendi belirlediğin rastgele metin.
# Meta panelinde aynısını yazacaksın.
WHATSAPP_VERIFY_TOKEN=""

# Giden mesaj (otomatik cevap, toplu hatırlatma) için kalıcı erişim token'ı ve numara kimliği.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Meta ONAYLI şablon adları. 24 saatlik pencere DIŞINDA serbest metin gönderilemez.
WHATSAPP_TEMPLATE=""         # borç hatırlatma  — {{1}} ad, {{2}} borç, {{3}} telefon
WHATSAPP_TEMPLATE_SAYAC=""   # sayaç hatırlatma — {{1}} müşteri, {{2}} cihaz sayısı, {{3}} bayi
WHATSAPP_LANG="tr"

# Mesaj saklama süresi (gün). VARSAYILAN KAPALI — boş bırakırsan hiçbir mesaj silinmez.
# Yalnızca bayi sözleşmesinde bir saklama süresi taahhüt ettiysen doldur. En az 30.
WHATSAPP_SAKLAMA_GUN=""

# NOT: Hangi bayinin hangi WhatsApp numarasına ait olduğu env'de DEĞİL,
# Süper Admin → Bayi → Genel → "WhatsApp Numara Kimliği" alanında tutulur.

# ─────────────────────────────────────────────────────────────
# İSTEĞE BAĞLI — tanımsızsa ilgili özellik sessizce devre dışı kalır
# ─────────────────────────────────────────────────────────────

# Netgsm toplu SMS. Üçü birden tanımlı değilse SMS butonu hiç görünmez.
NETGSM_USER=""
NETGSM_PASS=""
NETGSM_HEADER=""             # Netgsm'de ONAYLI gönderici başlığı

# Landing formundan gelen talepler Nexus CRM'e de aktarılsın istiyorsan.
# Tanımsız olsa bile talep VERİTABANINA yazılır, kaybolmaz.
NEXUS_CRM_URL=""
NEXUS_CRM_TOKEN=""
NEXUS_CRM_OLAY=""

# Uygulama portu (Coolify genelde kendisi verir)
PORT="3000"
